# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Puerto local publicado para la aplicación Tomcat.
APP_PORT=8080
# Puerto local publicado para Adminer.
ADMINER_PORT=8081
# Host, puerto y nombre de la base usados por la aplicación dentro de Compose.
DB_HOST=db
DB_PORT=3306
DB_NAME=bikestore
# Usuario y contraseña de aplicación; deben coincidir con MYSQL_USER y MYSQL_PASSWORD.
DB_USER=bikestore
DB_PASSWORD=cambia_esta_clave
# Límites de conexiones HikariCP y timeout de adquisición (milisegundos).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000
# Valores de inicialización de la imagen MySQL; DB_NAME y MYSQL_DATABASE deben coincidir.
MYSQL_DATABASE=bikestore
MYSQL_USER=bikestore
MYSQL_PASSWORD=cambia_esta_clave
# Contraseña administrativa local para el healthcheck y tareas de administración.
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root